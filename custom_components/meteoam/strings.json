{
  "config": {
    "step": {
      "user": {
        "title": "[%key:common::config_flow::data::location%]",
        "description": "Meteo Aeronautica Militare",
        "data": {
          "name": "[%key:common::config_flow::data::name%]",
          "latitude": "[%key:common::config_flow::data::latitude%]",
          "longitude": "[%key:common::config_flow::data::longitude%]",
          "station_observations": "Enable station observations"
        },
        "data_description": {
          "station_observations": "Enable real-time weather observations from the nearest METAR/SYNOP station. Creates additional sensor entities that update every 5 minutes."
        }
      }
    },
    "error": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_service%]"
    },
    "abort": {
      "no_home": "No home coordinates are set in the Home Assistant configuration",
      "already_configured": "[%key:common::config_flow::abort::already_configured_service%]"
    }
  },
  "entity": {
    "sensor": {
      "observed_temperature": {
        "name": "Observed temperature"
      },
      "observed_humidity": {
        "name": "Observed humidity"
      },
      "observed_pressure": {
        "name": "Observed pressure"
      },
      "observed_wind_speed": {
        "name": "Observed wind speed"
      },
      "observed_wind_bearing": {
        "name": "Observed wind bearing"
      },
      "observed_wind_cardinal": {
        "name": "Observed wind cardinal"
      }
    }
